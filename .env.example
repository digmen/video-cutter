BOT_TOKEN=
# Локальный Bot API (docker на 127.0.0.1:8082), поднимает лимит до 2 ГБ
BOT_API_ROOT=http://127.0.0.1:8082
# Где Bot API кладёт файлы: путь ВНУТРИ его контейнера и путь на ХОСТЕ (том смонтирован)
BOTAPI_DIR_CONTAINER=/var/lib/telegram-bot-api
BOTAPI_DIR_HOST=/root/video-cutter/botapi
# Рабочая папка бота (нарезки, база)
DATA_DIR=/root/video-cutter/data
# Твой Telegram id — тебе без лимитов
OWNER_ID=1145935758
# Канал-вход: пусто → без проверки подписки
CHANNEL=@DigmenDevLogs
# Сколько задач резать одновременно (защита сервера рядом с VPN-ботами)
MAX_CONCURRENT=1
DB_PATH=/root/video-cutter/data/cutter.db
